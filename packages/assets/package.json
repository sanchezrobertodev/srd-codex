{
  "name": "@dnd/assets",
  "version": "0.1.0",
  "description": "The Codex's pictures and icons: the art manifest (artFor), the licence log and the release check.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./licences.json": "./licences.json",
    "./files/*": "./files/*",
    "./release": "./src/release.ts",
    "./art/art.json": "./art/art.json",
    "./art": "./src/art.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "vite": "^8.3.0"
  }
}
